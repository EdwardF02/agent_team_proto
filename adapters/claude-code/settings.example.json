{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/reread-runbook.py\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/deny-hook-bypass.py\"", "timeout": 10 } ] },
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/guards.py\"", "timeout": 45 } ] },
      { "matcher": "mcp__playwright__.*",
        "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/account-guard.py\"", "timeout": 10 } ] },
      { "matcher": "Agent",
        "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/wait-bracket.py\"", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/wait-bracket.py\"", "timeout": 15 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/log-session.py\" session_start" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 \"{{KIT}}/adapters/claude-code/hooks/log-session.py\" session_end" } ] }
    ]
  }
}
